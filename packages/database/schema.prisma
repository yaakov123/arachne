// Prisma schema for Arachne HTTP Proxy
// Database: SQLite for simplicity and portability

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Projects table - replaces metadata.json files
model Project {
  id          String   @id @default(cuid()) // UUID with fallback to existing project IDs
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tags        Json?
  
  // Settings stored as JSON
  settings     Json
  
  // Relationships
  transactions Transaction[]
  hosts        Host[]
  authProfiles AuthProfile[]
  
  @@map("projects")
}

// Main transactions table - replaces transactions.jsonl
model Transaction {
  id        String   @id // conn_xxx:req_xxx format
  timestamp DateTime
  
  // Project relationship
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Host relationship
  hostId    String
  host      Host @relation(fields: [hostId], references: [id], onDelete: Cascade)
  
  // Request data
  method   String
  clientIp String?
  
  // URL data (denormalized for performance)
  urlFull     String
  urlProtocol String
  urlHost     String
  urlPort     Int?
  urlPath     String
  urlQuery    String?
  urlFragment String?
  
  // Response data
  statusCode    Int?
  statusMessage String?
  
  // Timing data
  duration     Int?    // Duration in milliseconds
  
  // Summary data
  requestSize     Int?     @default(0)
  responseSize    Int?     @default(0)
  hasRequestBody  Boolean  @default(false)
  hasResponseBody Boolean  @default(false)
  
  // Metadata
  metadataType    String?  // 'request-editor', etc. - for future extensibility

  
  // Body foreign keys
  requestBodyId   String?
  responseBodyId  String?
  
  // Metadata foreign keys
  requestEditorMetadataId String? @unique

  // Relationships
  requestHeaders  TransactionHeader[] @relation("RequestHeaders")
  responseHeaders TransactionHeader[] @relation("ResponseHeaders")
  requestBody     TransactionBody?    @relation("RequestBody", fields: [requestBodyId], references: [id])
  responseBody    TransactionBody?    @relation("ResponseBody", fields: [responseBodyId], references: [id])
  
  // Metadata relationships
  requestEditorMetadata RequestEditorMetadata? @relation(fields: [requestEditorMetadataId], references: [id])
  
  @@index([projectId])
  @@index([hostId])
  @@index([timestamp])
  @@index([urlHost])
  @@index([method])
  @@index([statusCode])
  @@index([metadataType])
  @@map("transactions")
}

// Headers table - both request and response headers
model TransactionHeader {
  id                    String  @id @default(cuid())
  requestTransactionId  String?
  responseTransactionId String?
  headerType            String  // 'request' | 'response'
  name                  String
  value                 String
  
  // Relationships
  requestTransaction  Transaction? @relation("RequestHeaders", fields: [requestTransactionId], references: [id], onDelete: Cascade)
  responseTransaction Transaction? @relation("ResponseHeaders", fields: [responseTransactionId], references: [id], onDelete: Cascade)
  
  @@index([requestTransactionId])
  @@index([responseTransactionId])
  @@index([headerType])
  @@index([name])
  @@map("transaction_headers")
}

// Body content table - both request and response bodies
model TransactionBody {
  id            String  @id @default(cuid())
  bodyType      String  // 'request' | 'response'
  
  // Content metadata
  contentType     String?
  contentEncoding String?
  size            Int
  sampleSize      Int
  truncated       Boolean
  detectedFormat  String? // 'json' | 'xml' | 'html' | 'css' | 'javascript' | 'text' | 'binary' | 'image' | 'form'
  encoding        String  // 'utf8' | 'base64'
  isCompressed    Boolean @default(false)
  
  // Content sample (limited size)
  sample String // The actual body content sample
  
  // Relationships (back-references from Transaction)
  requestTransactions  Transaction[] @relation("RequestBody")
  responseTransactions Transaction[] @relation("ResponseBody")
  
  @@index([bodyType])
  @@index([detectedFormat])
  @@map("transaction_bodies")
}


// Active project tracking - replaces active-project.json
model SystemConfig {
  id               String    @id @default("system")
  activeProjectId  String?
  lastUpdated      DateTime  @default(now())
  
  @@map("system_config")
}

// Inventory/Analytics tables for better querying
model Host {
  id          String @id @default(cuid()) // Changed from hostname to cuid
  hostname    String // The actual hostname
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())
  
  // Project relationship
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  endpoints     Endpoint[]
  transactions  Transaction[]
  
  @@unique([projectId, hostname])
  @@index([projectId])
  @@map("hosts")
}

model Endpoint {
  id          String @id @default(cuid())
  hostId      String
  method      String
  path        String
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())
  hits        Int      @default(0)

  host        Host @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@unique([hostId, method, path])
  @@index([hostId])
  @@index([method])
  @@map("endpoints")
}

// Request Editor Metadata table - stores additional data for requests sent via Request Editor
model RequestEditorMetadata {
  id              String   @id @default(cuid())
  
  // Original form data from the request editor
  originalUrl     String   // URL as entered in the editor (before query param processing)
  originalMethod  String   // Method as selected in the editor
  
  // Editor state when request was sent
  activeRequestTab  String?  // Which tab was active: 'headers', 'body', 'params'
  bodyType         String?  // 'json', 'text', 'form', 'xml'
  
  // User notes and context
  userNotes       String?  // Optional user notes about this request
  tags            Json?    // Array of strings for organization
  
  // Timestamps
  createdAt       DateTime @default(now())
  
  // Relationship back to transaction (one-to-one via Transaction.requestEditorMetadataId)
  transaction     Transaction?
  
  @@map("request_editor_metadata")
}

// Authentication profiles table
model AuthProfile {
  id          String   @id @default(cuid())
  name        String
  description String?
  method      String   // 'bearer', 'api-key', 'basic', 'jwt', 'oauth2', 'custom-header', 'custom'
  enabled     Boolean  @default(true)
  priority    Int?     @default(100)
  tags        Json?    // Array of strings for organization
  
  // Auth configuration stored as JSON
  authConfig  Json     // Complete auth method configuration
  
  // Conditions for when to apply (stored as JSON)
  conditions  Json?    // AuthCondition object
  
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  
  // Project relationship
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@index([projectId])
  @@index([method])
  @@index([enabled])
  @@index([priority])
  @@map("auth_profiles")
}
