{
    "name": "arachne-monorepo",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "packageManager": "npm@10.0.0",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "turbo build",
        "dev": "turbo run dev",
        "lint": "turbo lint",
        "type-check": "turbo type-check",
        "test": "turbo test",
        "cleanup": "turbo run cleanup",
        "prettier": "npx prettier --write .",
        "test:watch": "vitest --watch",
        "test:ci": "turbo build --filter=@arachne/proxy && vitest --run"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.40.0",
        "@typescript-eslint/parser": "^8.40.0",
        "eslint": "^9.33.0",
        "turbo": "^2.5.6",
        "typescript": "^5.0.0",
        "vitest": "^3.2.4"
    }
}