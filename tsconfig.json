{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "baseUrl": ".",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "declaration": true,
        "declarationMap": true,
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "composite": true,
        "paths": {
            "@arachne/proxy": ["./packages/proxy/src/index.ts"],
            "@arachne/recorder": ["./packages/recorder/src/index.ts"]
        }
    },
    "files": [],
    "references": [
        { "path": "./packages/proxy" },
        { "path": "./packages/recorder" },
        { "path": "./packages/backend" }
    ]
}
